      },
      "canonical": {
        "schema": "org.whl.raster.processing-operation",
        "version": 1,
        "algorithm": "unsharp-mask-v1",
        "rule": "pillow_unsharp_mask(radius=radius_tenths/10, percent=amount_percent, threshold=threshold)",
        "radius_tenths": 10,
        "amount_percent": 150,
        "threshold": 3
      }
    },
    {
