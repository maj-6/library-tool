        "algorithm": "kernel-sharpen-v1",
        "parameters": {}
      },
      "canonical": {
        "schema": "org.whl.raster.processing-operation",
        "version": 1,
        "algorithm": "kernel-sharpen-v1",
        "rule": "3x3 kernel [[0,-1,0],[-1,5,-1],[0,-1,0]] blended with identity at strength_percent/100",
        "strength_percent": 50
      }
    },
    {
      "authoring": {
        "algorithm": "gamma-v1",
        "parameters": {}
      },
      "canonical": {
        "schema": "org.whl.raster.processing-operation",
        "version": 1,
        "algorithm": "gamma-v1",
        "rule": "round_half_up(255 * (value/255) ** (100/gamma_hundredths)), clamped_0_255",
        "gamma_hundredths": 100
      }
    },
    {
      "authoring": {
        "algorithm": "contrast-v1",
        "parameters": {}
      },
      "canonical": {
        "schema": "org.whl.raster.processing-operation",
        "version": 1,
        "algorithm": "contrast-v1",
        "rule": "factor = 1 + contrast_percent/100 when positive else 1 + contrast_percent/100 toward 127.5; round_half_up(127.5 + (value - 127.5) * factor), clamped_0_255",
        "contrast_percent": 0
      }
    },
    {
