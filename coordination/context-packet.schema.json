{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldherblibrary.org/schemas/studio-context-packet-1.0.json",
  "title": "Living Edition Studio context packet",
  "description": "Closed, digest-pinned semantic context for one Studio implementation, integration, or review session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "revision",
    "issued_at",
    "previous_revision",
    "audience",
    "assignment",
    "profile",
    "pins",
    "budget",
    "required_context",
    "activated_expansion_ids",
    "review_of"
  ],
  "properties": {
    "schema": {
      "const": "studio-context-packet/1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*-CONTEXT-[0-9]{3}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "previous_revision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reviewedPacketPin"
        }
      ]
    },
    "audience": {
      "enum": ["implementer", "integrator", "reviewer"]
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "profile": {
      "$ref": "#/$defs/profilePin"
    },
    "pins": {
      "$ref": "#/$defs/pins"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "required_context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/contextEntry"
      }
    },
    "activated_expansion_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "review_of": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reviewOf"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "previous_revision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_revision": {
            "$ref": "#/$defs/reviewedPacketPin"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audience": {
            "const": "reviewer"
          }
        },
        "required": ["audience"]
      },
      "then": {
        "properties": {
          "assignment": {
            "properties": {
              "access_mode": {
                "const": "read-only-review"
              }
            }
          },
          "review_of": {
            "$ref": "#/$defs/reviewOf"
          }
        }
      },
      "else": {
        "properties": {
          "assignment": {
            "properties": {
              "access_mode": {
                "const": "write-lease"
              }
            }
          },
          "review_of": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9._@+\\-]+(?:/[A-Za-z0-9._@+\\-]+)*$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)[^/]*\\.(/|$)"
          }
        }
      ]
    },
    "gitRef": {
      "type": "string",
      "pattern": "^refs/(heads|tags)/[A-Za-z0-9._@+\\-/]+$"
    },
    "notApplicablePhasePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "const": "not-applicable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredPhasePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "tag",
        "tag_object",
        "remote_tag_object",
        "commit",
        "tree",
        "verification_status",
        "lock"
      ],
      "properties": {
        "status": {
          "const": "required"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "remote_tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "commit": {
          "$ref": "#/$defs/hex40"
        },
        "tree": {
          "$ref": "#/$defs/hex40"
        },
        "verification_status": {
          "const": "verified"
        },
        "lock": {
          "$ref": "#/$defs/gitBlobPin"
        }
      }
    },
    "contractPhasePin": {
      "oneOf": [
        {
          "$ref": "#/$defs/notApplicablePhasePin"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/requiredPhasePin"
            },
            {
              "properties": {
                "lock": {
                  "properties": {
                    "path": {
                      "const": "contracts/contracts.lock.json"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "fixturePhasePin": {
      "oneOf": [
        {
          "$ref": "#/$defs/notApplicablePhasePin"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/requiredPhasePin"
            },
            {
              "properties": {
                "lock": {
                  "properties": {
                    "path": {
                      "const": "fixtures/fixtures.lock.json"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "gitBlobPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "git_blob_oid", "digest_domain", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "commit": {
          "$ref": "#/$defs/hex40"
        },
        "git_blob_oid": {
          "$ref": "#/$defs/hex40"
        },
        "digest_domain": {
          "const": "git-blob-payload-sha256/1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "activationLedgerPin": {
      "allOf": [
        {
          "$ref": "#/$defs/gitBlobPin"
        },
        {
          "properties": {
            "path": {
              "const": "coordination/studio-ledger.json"
            }
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "work_package",
        "accountable_owner",
        "branch",
        "worktree",
        "access_mode",
        "lease_id",
        "lease_entries",
        "assignment_receipt_id",
        "authoritative_remote_url",
        "reserved_ids",
        "permitted_imports",
        "required_ports",
        "required_outputs",
        "acceptance_commands",
        "known_upstream_limitations",
        "non_goals",
        "composition_instructions",
        "return_destination",
        "s00_contact",
        "escalation_destination"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/stableId"
        },
        "work_package": {
          "$ref": "#/$defs/stableId"
        },
        "accountable_owner": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "access_mode": {
          "enum": ["write-lease", "read-only-review"]
        },
        "lease_id": {
          "$ref": "#/$defs/stableId"
        },
        "lease_entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/leaseEntry"
          }
        },
        "assignment_receipt_id": {
          "$ref": "#/$defs/stableId"
        },
        "authoritative_remote_url": {
          "const": "https://github.com/maj-6/library-tool.git"
        },
        "reserved_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permitted_imports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_upstream_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composition_instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "return_destination": {
          "type": "string",
          "minLength": 1
        },
        "s00_contact": {
          "type": "string",
          "minLength": 1
        },
        "escalation_destination": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "profile_id", "manifest", "manifest_jcs_sha256"],
      "properties": {
        "schema": {
          "const": "studio-context-profiles/1"
        },
        "profile_id": {
          "enum": [
            "B00",
            "C00",
            "T01",
            "E10",
            "D20",
            "U20",
            "E11-E21",
            "U21-U27",
            "I30"
          ]
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/gitBlobPin"
            },
            {
              "properties": {
                "path": {
                  "const": "coordination/context-profiles.json"
                }
              }
            }
          ]
        },
        "manifest_jcs_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "coordinationPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "ledger_commit",
        "ledger_path",
        "ledger_git_blob_oid",
        "digest_domain",
        "sha256",
        "protection_receipt_id"
      ],
      "properties": {
        "ref": {
          "const": "refs/heads/studio-s00-coordination"
        },
        "ledger_commit": {
          "$ref": "#/$defs/hex40"
        },
        "ledger_path": {
          "const": "coordination/studio-ledger.json"
        },
        "ledger_git_blob_oid": {
          "$ref": "#/$defs/hex40"
        },
        "digest_domain": {
          "const": "git-blob-payload-sha256/1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protection_receipt_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "basePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "tag_object",
        "remote_tag_object",
        "commit",
        "tree",
        "verification_status"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "remote_tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "commit": {
          "$ref": "#/$defs/hex40"
        },
        "tree": {
          "$ref": "#/$defs/hex40"
        },
        "verification_status": {
          "const": "verified"
        }
      }
    },
    "protocolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "tag_object",
        "remote_tag_object",
        "commit",
        "tree",
        "verification_status",
        "protocol_version",
        "handoff",
        "specification_revision",
        "specification"
      ],
      "properties": {
        "tag": {
          "const": "studio-adoption-v1.1.1"
        },
        "tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "remote_tag_object": {
          "$ref": "#/$defs/hex40"
        },
        "commit": {
          "$ref": "#/$defs/hex40"
        },
        "tree": {
          "$ref": "#/$defs/hex40"
        },
        "verification_status": {
          "const": "verified"
        },
        "protocol_version": {
          "const": "1.0.1"
        },
        "handoff": {
          "allOf": [
            {
              "$ref": "#/$defs/gitBlobPin"
            },
            {
              "properties": {
                "path": {
                  "const": "docs/living-edition-concurrent-session-handoff.md"
                }
              }
            }
          ]
        },
        "specification_revision": {
          "const": "1.1.1"
        },
        "specification": {
          "allOf": [
            {
              "$ref": "#/$defs/gitBlobPin"
            },
            {
              "properties": {
                "path": {
                  "const": "docs/living-edition-production-build-spec.md"
                }
              }
            }
          ]
        }
      }
    },
    "contextSchemaPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "artifact"],
      "properties": {
        "schema_id": {
          "const": "https://worldherblibrary.org/schemas/studio-context-packet-1.0.json"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/gitBlobPin"
            },
            {
              "properties": {
                "path": {
                  "const": "coordination/context-packet.schema.json"
                }
              }
            }
          ]
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordination",
        "base",
        "contract",
        "fixture",
        "protocol",
        "context_schema"
      ],
      "properties": {
        "coordination": {
          "$ref": "#/$defs/coordinationPin"
        },
        "base": {
          "$ref": "#/$defs/basePin"
        },
        "contract": {
          "$ref": "#/$defs/contractPhasePin"
        },
        "fixture": {
          "$ref": "#/$defs/fixturePhasePin"
        },
        "protocol": {
          "$ref": "#/$defs/protocolPin"
        },
        "context_schema": {
          "$ref": "#/$defs/contextSchemaPin"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "default_utf8_bytes",
        "hard_max_utf8_bytes",
        "authorized_utf8_bytes",
        "selected_utf8_bytes",
        "manifest_jcs_bytes",
        "manifest_hard_max_bytes",
        "above_default_reason"
      ],
      "properties": {
        "unit": {
          "const": "utf8-bytes"
        },
        "default_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "hard_max_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "authorized_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "selected_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_jcs_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "manifest_hard_max_bytes": {
          "const": 65536
        },
        "above_default_reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "headingAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading_level", "heading_text", "occurrence"],
      "properties": {
        "heading_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "heading_text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "wholeGitBlobSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "whole-git-blob/1"
        }
      }
    },
    "markdownHeadingSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "heading_level", "heading_text", "occurrence"],
      "properties": {
        "kind": {
          "const": "markdown-heading-section/1"
        },
        "heading_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "heading_text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "markdownTableRowSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "containing_heading",
        "table_columns",
        "table_occurrence",
        "key_column",
        "key_value"
      ],
      "properties": {
        "kind": {
          "const": "markdown-table-row/1"
        },
        "containing_heading": {
          "$ref": "#/$defs/headingAnchor"
        },
        "table_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^|\\r\\n]+$"
          }
        },
        "table_occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "key_column": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^|\\r\\n]+$"
        },
        "key_value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^|\\r\\n]+$"
        }
      }
    },
    "jsonScalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "jsonPointerSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pointer"],
      "properties": {
        "kind": {
          "const": "rfc6901-json-pointer/1"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "expected_identity": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonScalar"
          }
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/wholeGitBlobSelector"
        },
        {
          "$ref": "#/$defs/markdownHeadingSelector"
        },
        {
          "$ref": "#/$defs/markdownTableRowSelector"
        },
        {
          "$ref": "#/$defs/jsonPointerSelector"
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_domain", "sha256", "selected_utf8_bytes"],
      "properties": {
        "digest_domain": {
          "enum": ["selected-git-blob-bytes-sha256/1", "rfc8785-jcs-sha256/1"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "capsule",
        "expansion_id",
        "purpose",
        "repository_url",
        "media_type",
        "source",
        "selector",
        "selection"
      ],
      "properties": {
        "context_id": {
          "$ref": "#/$defs/stableId"
        },
        "capsule": {
          "enum": ["universal", "package", "expansion"]
        },
        "expansion_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stableId"
            }
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "const": "https://github.com/maj-6/library-tool.git"
        },
        "media_type": {
          "enum": [
            "text/markdown; charset=utf-8",
            "application/json; charset=utf-8",
            "text/plain; charset=utf-8"
          ]
        },
        "source": {
          "$ref": "#/$defs/gitBlobPin"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capsule": {
                "const": "expansion"
              }
            },
            "required": ["capsule"]
          },
          "then": {
            "properties": {
              "expansion_id": {
                "$ref": "#/$defs/stableId"
              }
            }
          },
          "else": {
            "properties": {
              "expansion_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selector": {
                "properties": {
                  "kind": {
                    "const": "rfc6901-json-pointer/1"
                  }
                },
                "required": ["kind"]
              }
            },
            "required": ["selector"]
          },
          "then": {
            "properties": {
              "media_type": {
                "const": "application/json; charset=utf-8"
              },
              "selection": {
                "properties": {
                  "digest_domain": {
                    "const": "rfc8785-jcs-sha256/1"
                  }
                },
                "required": ["digest_domain"]
              }
            }
          },
          "else": {
            "properties": {
              "selection": {
                "properties": {
                  "digest_domain": {
                    "const": "selected-git-blob-bytes-sha256/1"
                  }
                },
                "required": ["digest_domain"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selector": {
                "properties": {
                  "kind": {
                    "enum": [
                      "markdown-heading-section/1",
                      "markdown-table-row/1"
                    ]
                  }
                },
                "required": ["kind"]
              }
            },
            "required": ["selector"]
          },
          "then": {
            "properties": {
              "media_type": {
                "const": "text/markdown; charset=utf-8"
              }
            }
          }
        }
      ]
    },
