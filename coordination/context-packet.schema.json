              "expansion_id": {
                "$ref": "#/$defs/stableId"
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    }
  }
}
