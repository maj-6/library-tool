    "profileTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "capsule", "source_id", "selector", "purpose"],
      "properties": {
        "context_id": {
          "$ref": "#/$defs/stableId"
        },
        "capsule": {
          "enum": ["universal", "package"]
        },
        "source_id": {
          "$ref": "#/$defs/stableId"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profilePhaseExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "not_applicable_reason"],
      "properties": {
        "expectation": {
          "enum": ["required", "not-applicable", "producer"]
        },
        "not_applicable_reason": {
          "enum": [
            null,
            "contract tag does not exist",
            "fixture tag does not exist",
            "C00 produces the contract tag",
            "T01 produces the fixture tag"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "required"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "properties": {
              "not_applicable_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "requiredInitialExpansionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expansion_id", "phase_pin", "route_pointer_template"],
      "properties": {
        "expansion_id": {
          "$ref": "#/$defs/stableId"
        },
        "phase_pin": {
          "enum": ["contract", "fixture"]
        },
        "route_pointer_template": {
          "const": "/context_routes/{work_package}"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "work_packages",
        "required_base",
        "contract_pin",
        "fixture_pin",
        "default_utf8_bytes",
        "hard_max_utf8_bytes",
        "templates",
        "package_templates",
        "required_initial_expansion_routes",
        "allowed_expansion_ids"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "B00",
            "C00",
            "T01",
            "E10",
            "D20",
            "U20",
            "E11-E21",
            "U21-U27",
            "I30"
          ]
        },
        "work_packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "required_base": {
          "type": "string",
          "minLength": 1
        },
        "contract_pin": {
          "$ref": "#/$defs/profilePhaseExpectation"
        },
        "fixture_pin": {
          "$ref": "#/$defs/profilePhaseExpectation"
        },
        "default_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "hard_max_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileTemplate"
          }
        },
        "package_templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["work_package", "templates"],
            "properties": {
              "work_package": {
                "$ref": "#/$defs/stableId"
              },
              "templates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/profileTemplate"
                }
              }
            }
          }
        },
        "required_initial_expansion_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requiredInitialExpansionRoute"
          }
        },
        "allowed_expansion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile_id": {
                "const": "B00"
              }
            },
            "required": ["profile_id"]
          },
          "then": {
            "properties": {
              "contract_pin": {
                "const": {
                  "expectation": "not-applicable",
                  "not_applicable_reason": "contract tag does not exist"
                }
              },
              "fixture_pin": {
                "const": {
                  "expectation": "not-applicable",
                  "not_applicable_reason": "fixture tag does not exist"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_id": {
                "const": "C00"
              }
            },
            "required": ["profile_id"]
          },
          "then": {
            "properties": {
              "contract_pin": {
                "const": {
                  "expectation": "producer",
                  "not_applicable_reason": "C00 produces the contract tag"
                }
              },
              "fixture_pin": {
                "const": {
                  "expectation": "not-applicable",
                  "not_applicable_reason": "fixture tag does not exist"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_id": {
                "const": "T01"
              }
            },
            "required": ["profile_id"]
          },
          "then": {
            "properties": {
              "contract_pin": {
                "const": {
                  "expectation": "required",
                  "not_applicable_reason": null
                }
              },
              "fixture_pin": {
                "const": {
                  "expectation": "producer",
                  "not_applicable_reason": "T01 produces the fixture tag"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_id": {
                "enum": ["E10", "D20", "U20", "E11-E21", "U21-U27", "I30"]
              }
            },
            "required": ["profile_id"]
          },
          "then": {
            "properties": {
              "contract_pin": {
                "const": {
                  "expectation": "required",
                  "not_applicable_reason": null
                }
              },
              "fixture_pin": {
                "const": {
                  "expectation": "required",
                  "not_applicable_reason": null
                }
              }
            }
          }
        }
      ]
    },
