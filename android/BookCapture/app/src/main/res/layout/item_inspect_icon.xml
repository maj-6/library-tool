<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/whl_inspect_panel"
    android:gravity="center_horizontal"
    android:minHeight="116dp"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/inspectThumb"
        android:layout_width="50dp"
        android:layout_height="68dp"
        android:background="@color/whl_face_sh"
        android:foreground="@drawable/whl_thumbnail_frame"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_app_mark" />

    <TextView
        android:id="@+id/inspectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.94"
        android:lines="2"
        android:textColor="@color/whl_ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/inspectSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="1"
        android:textColor="@color/whl_ink_dim"
        android:textSize="10sp" />
</LinearLayout>
