<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/whl_inspect_row"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no">

        <View
            android:id="@+id/inspectCoverSwatch"
            android:layout_width="8dp"
            android:layout_height="26dp"
            android:layout_gravity="start|center_vertical"
            android:background="@color/whl_face_sh2"
            android:importantForAccessibility="no" />

        <include
            layout="@layout/view_scan_priority_indicator"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end" />
    </FrameLayout>

    <TextView
        android:id="@+id/inspectTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:textColor="@color/whl_ink"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/inspectAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingEnd="6dp"
        android:textColor="@color/whl_ink_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/inspectYear"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/whl_ink_dim"
        android:textSize="10sp" />
</LinearLayout>
