<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/whl_inspect_row"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="50dp"
        android:layout_marginEnd="9dp"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/inspectThumb"
            android:layout_width="34dp"
            android:layout_height="46dp"
            android:layout_gravity="start|center_vertical"
            android:background="@color/whl_face_sh"
            android:foreground="@drawable/whl_thumbnail_frame"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_app_mark" />

        <include
            layout="@layout/view_scan_priority_indicator"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inspectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/whl_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/inspectSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/whl_ink_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/inspectLookupCollection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_slab"
            android:maxLines="1"
            android:textColor="@color/whl_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
