<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/whl_inspect_panel"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/inspectThumb"
        android:layout_width="42dp"
        android:layout_height="58dp"
        android:layout_marginEnd="6dp"
        android:background="@color/whl_face_sh"
        android:foreground="@drawable/whl_thumbnail_frame"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_app_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inspectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.94"
            android:maxLines="2"
            android:textColor="@color/whl_ink"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/inspectSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.94"
            android:maxLines="2"
            android:textColor="@color/whl_ink_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
